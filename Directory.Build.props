<Project>
  <PropertyGroup>
    <!-- Branch: CSharp_FE9_BE10 — FE=.NET 9, BE=.NET 10. Do not swap or equalize. -->
    <FrontendTargetFramework>net9.0</FrontendTargetFramework>
    <BackendTargetFramework>net10.0</BackendTargetFramework>
    <FrontendDotnetVersion>9</FrontendDotnetVersion>
    <BackendDotnetVersion>10</BackendDotnetVersion>
    <BranchName>CSharp_FE9_BE10</BranchName>
    <SharedTargetFrameworks>net9.0;net10.0</SharedTargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
