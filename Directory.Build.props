<Project>
  <PropertyGroup>
    <!-- Branch: CSharp_FE10_BE8 — FE=.NET 10, BE=.NET 8. Do not swap or equalize. -->
    <FrontendTargetFramework>net10.0</FrontendTargetFramework>
    <BackendTargetFramework>net8.0</BackendTargetFramework>
    <FrontendDotnetVersion>10</FrontendDotnetVersion>
    <BackendDotnetVersion>8</BackendDotnetVersion>
    <BranchName>CSharp_FE10_BE8</BranchName>
    <SharedTargetFrameworks>net10.0;net8.0</SharedTargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
