<Project>
  <PropertyGroup>
    <!-- Branch: CSharp_FE9_BE8 — FE=.NET 9, BE=.NET 8. Do not swap or equalize. -->
    <FrontendTargetFramework>net9.0</FrontendTargetFramework>
    <BackendTargetFramework>net8.0</BackendTargetFramework>
    <FrontendDotnetVersion>9</FrontendDotnetVersion>
    <BackendDotnetVersion>8</BackendDotnetVersion>
    <BranchName>CSharp_FE9_BE8</BranchName>
    <SharedTargetFrameworks>net9.0;net8.0</SharedTargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
