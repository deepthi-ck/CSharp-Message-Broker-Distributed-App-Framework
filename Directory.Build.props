<Project>
  <PropertyGroup>
    <!-- Branch: CSharp_FE9_BE6 — FE=.NET 9, BE=.NET 6. Do not swap or equalize. -->
    <FrontendTargetFramework>net9.0</FrontendTargetFramework>
    <BackendTargetFramework>net6.0</BackendTargetFramework>
    <FrontendDotnetVersion>9</FrontendDotnetVersion>
    <BackendDotnetVersion>6</BackendDotnetVersion>
    <BranchName>CSharp_FE9_BE6</BranchName>
    <SharedTargetFrameworks>net9.0;net6.0</SharedTargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
